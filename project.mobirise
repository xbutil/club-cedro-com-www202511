            ".card3": {
              "background-image": "url(@card3bg)",
              "z-index": "2",
              "transform": "rotateY(-15deg)"
            },
            "h4": {
              "font-weight": "500",
              "margin-bottom": "0",
              "text-shadow": "1px 3px 0 #1174b2, 1px 13px 5px #aba8a8"
            },
            ".btn": {
              "margin": "0!important",
              "padding": "1rem 2rem"
