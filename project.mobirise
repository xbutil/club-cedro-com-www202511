              "color": "#283c88"
            }
          },
          "_name": "info4",
          "_sourceTheme": "audiom4",
          "_customHTML": "<section class=\"info4 audiom4_info4\" group=\"Info\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1280.webp\" parallax selected>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#f7f4f2\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7f4f2\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container-fluid align-center\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"mbr-black col-md-12 col-lg-12\">\n\t\t\t\t<h1 class=\"mbr-section-title align-center mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n\t\t\t\t\t<i>Sedes</i></h1>\n\t\t\t\t<p class=\"mbr-text align-center mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .img-align\">• <b>10</b> sedes en <b>Bogotá</b> - Colombia •</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "v1VLSCrtGV",
          "_anchor": "info4-1b",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "slider02",
          "_sourceTheme": "chargem5",
          "_customHTML": "<section class=\"slider02 mbr-embla chargem5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\">\n        <input type=\"color\" title=\"Arrows Color\" value=\"#000000\" name=\"arrowsColor\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Arrows BG\" value=\"#ffffff\" name=\"arrowsBg\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Arrows Shadow\" value=\"#e5e3ff\" name=\"shadow\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#1174b2\" name=\"activeColor\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Active BG\" value=\"#1174b2\" name=\"activeBg\" condition=\"arrows\" selected>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"50\" step=\"10\" value=\"0\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Card BG 1\" value=\"#283c88\" name=\"cardBg_1\">\n        <input type=\"color\" title=\"Card BG 2\" value=\"#2072c1\" name=\"cardBg_2\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg-club-cedro-min-1000x1228.webp\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#e2e6e7\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                \n                                <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_1\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-colegio-santo-angel-1940x1453.webp\" alt=\"Colegio Salto Ángel\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                                                </div>\n                                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_1, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                                    <b>Colegio del Santo Ángel</b></h4>\n                                                <p class=\"item-text_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\" mbr-if=\"showText\">\n                                                    Calle 165 # 7-21<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-success\" data-app-placeholder=\"Type Text\" href=\"popup:#mbr-popup-1c\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_2\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-colegio-virrey-solis-1000x563.webp\" alt=\"Colegio Franciscano Virrey Solís\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                                </div>\n                                                <h4 class=\"item-title_2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_2, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                                    <b>Colegio Franciscano Virrey Solís</b></h4>\n                                                <p class=\"item-text_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_2\" mbr-if=\"showText\">\n                                                    Cale 195 # 50-65<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"popup:#mbr-popup-1c\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_1\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-colegio-jose-joaquin-casas-700x525.webp\" alt=\"Colegio José Joaquín Casas\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                                </div>\n                                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>Colegio José Joaquín Casas</b></h4>\n                                                <p class=\"item-text_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\" mbr-if=\"showText\">\n                                                    Carrera 7 # 173-02<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-success\" href=\"popup:#mbr-popup-1c\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_2\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-colegio-santiago-alberione-1000x749.webp\" alt=\"Colegio Santiago Alberione\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                                </div>\n                                                <h4 class=\"item-title_2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_2, .mbr-section-btn\" mbr-if=\"showTitle\"><p>\n                                                    <b>Colegio Santiago Alberione</b></p></h4>\n                                                <p class=\"item-text_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_2\" mbr-if=\"showText\">\n                                                    Carrera 62 # 169A-14<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"popup:#mbr-popup-1c\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_1\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-colegio-casablanca.webp\" alt=\"Colegio Casablanca\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                                                </div>\n                                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_1, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                                    <b>Colegio Casablanca</b></h4>\n                                                <p class=\"item-text_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\" mbr-if=\"showText\">\n                                                    Calle 164A # 8A-74<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-success\" data-app-placeholder=\"Type Text\" href=\"popup:#mbr-popup-1c\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_2\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-colegio-servita-700x526.webp\" alt=\"Coliseo de Servita\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                                                </div>\n                                                <h4 class=\"item-title_2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                                    <b>Coliseo de Servita</b></h4>\n                                                <p class=\"item-text_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\" mbr-if=\"showText\">\n                                                    Calle 165 # 7-32<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"popup:#mbr-popup-1c\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_1\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-universidad-san-buenaventura-700x929.webp\" alt=\"Universidad San Buenaventura\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                                                </div>\n                                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                                    <b>Universidad San Buenaventura</b></h4>\n                                                <p class=\"item-text_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\" mbr-if=\"showText\">\n                                                    Carrera 8H # 172-20<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-success\" href=\"popup:#mbr-popup-1c\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_2\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-parque-el-redil-700x773.webp\" alt=\"Parque El Redil\" data-slide-to=\"7\" data-bs-slide-to=\"7\">\n                                                </div>\n                                                <h4 class=\"item-title_2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                                    <b>Parque El Redil</b></h4>\n                                                <p class=\"item-text_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\" mbr-if=\"showText\">Calle 174 # 8-31<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"popup:#mbr-popup-1c\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_1\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-parque-madeira-playa-700x933.webp\" alt=\"Parque Cedro Madeira - Playa\" data-slide-to=\"8\" data-bs-slide-to=\"8\">\n                                                </div>\n                                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                                    <b>Parque Cedro Madeira – PLAYA</b></h4>\n                                                <p class=\"item-text_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\" mbr-if=\"showText\">\n                                                    Carrera 8 BIS A # 148-2<br>Bogotá – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-success\" href=\"popup:#mbr-popup-1c\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper card_2\">\n                                            <div class=\"item-content\">\n                                                <div class=\"item-img\">\n                                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/sede-gimnasio-caobos-chia-700x401.webp\" alt=\"Gimnasio Los Caobos - Chía\" data-slide-to=\"9\" data-bs-slide-to=\"9\">\n                                                </div>\n                                                <h4 class=\"item-title_2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>Gimnasio Los Caobos</b></h4>\n                                                <p class=\"item-text_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\" mbr-if=\"showText\">Vereda La Balsa<br>Chía – Cundinamarca – Colombia</p>\n                                            </div>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"popup:#mbr-popup-1c\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-1c\" data-bs-target=\"#mbr-popup-1c\">Ver mapa</a></div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri-left mobi-mbri mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri-right mobi-mbri mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "580px",
              "max-width": "580px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "height": "100%",
                  "padding": "30px",
                  "@media (max-width: 992px)": {
                    "padding": "15px"
                  },
                  ".item-content": {
                    ".item-img": {
                      "margin-bottom": "40px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "20px"
                      },
                      "img": {
                        "height": "450px",
                        "width": "100%",
                        "object-fit": "cover",
                        "@media (max-width: 992px)": {
                          "height": "250px"
                        }
                      }
                    },
                    ".item-title_1, .item-title_2": {
                      "position": "relative",
                      "z-index": "1",
                      "margin-bottom": "20px"
                    },
                    ".item-text_1, .item-text_2": {
                      "position": "relative",
                      "z-index": "1",
                      "margin-bottom": "20px"
                    }
                  },
                  ".mbr-section-btn": {
                    "position": "relative",
                    "z-index": "1",
                    ".btn": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".card_1": {
                  "background-color": "@cardBg_1"
                },
                ".card_2": {
                  "background-color": "@cardBg_2"
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "48%",
              "width": "42px",
              "height": "42px",
              "font-size": "14px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "box-shadow": "0.2rem 0.2rem 1rem @shadow !important",
              "opacity": "1 !important",
              "z-index": "2",
              "@media (max-width: 992px)": {
                "top": "0"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background-color": "@activeBg !important",
                "color": "@activeColor !important"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding": "0 80px 0 80px",
                "@media (max-width: 992px)": {
                  "padding": "4rem 0 0 0"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".item-title_1": {
              "color": "#000000"
            },
            ".item-title_2": {
              "color": "#000000"
            },
            ".item-text_1": {
              "color": "#e2e6e7"
            },
            ".item-text_2": {
              "color": "#000000"
            },
            ".item-title_1, .mbr-section-btn": {
              "color": "#e2e6e7"
            },
            ".item-title, .mbr-section-btn": {
              "color": "#000000"
            }
          },
