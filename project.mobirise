        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".nav-tabs .nav-item.open .nav-link:focus, .nav-tabs .nav-link.active:focus": {
              "outline": "none"
            },
            "h4": {
              "width": "fit-content",
              "display": "inline-block",
              "&:before": {
                "position": "absolute",
                "content": "''",
                "left": "50%",
                "top": "-120px",
                "bottom": "0",
                "width": "1px",
                "height": "100px",
                "background": "currentColor"
              },
              "position": "relative"
            },
            ".nav-tabs": {
              "-webkit-flex-wrap": "wrap",
              "flex-wrap": "wrap",
              "border": "none",
              "justify-content": "space-around"
            },
            ".tabs-col": {
              "overflow": "hidden"
            },
            ".tab-content": {
              "border-top": "1px solid lightgray",
              "padding": "0rem",
              "padding-top": "5rem"
            },
            ".nav-tabs .nav-link": {
              "color": "@tabsColor",
              "font-style": "normal",
              "padding": "1rem 1.5rem",
              "background": "transparent",
              "font-weight": "400",
              "border": "none",
              "border-radius": "0",
              "position": "relative",
              "&:before": {
                "position": "absolute",
                "content": "''",
                "bottom": "-5px",
                "left": "50%",
                "right": "50%",
                "transform": "translateX(-50%)",
                "width": "12px",
                "height": "12px",
                "border-radius": "100%",
                "border": "1px solid @tabsColor",
                "background": "white",
                "transition": "all 0.3s",
                "z-index": "9"
              },
              "&:after": {
                "position": "absolute",
                "content": "''",
                "bottom": "0px",
                "right": "50%",
                "width": "9999px",
                "height": "1px",
                "transition": "all 0.3s",
                "background": "transparent"
              },
              "&:hover": {
                "cursor": "pointer"
              },
              "&.active": {
                "font-weight": "400",
                "font-style": "normal",
                "&:before": {
                  "background": "@tabsColor"
                },
                "&:after": {
                  "background": "@tabsColor"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".nav-tabs": {
                "flex-direction": "row"
              },
              ".mbr-text, .nav-link": {
                "text-align": "center"
              },
              ".nav-tabs .nav-link": {
                "margin-bottom": "1rem",
                "&:after": {
                  "content": "none"
                },
                "border": "0"
              },
              ".nav-item": {
                "min-width": "100px"
              },
              ".tab-content": {
                "border-top": "0px",
                "padding-top": "2rem"
              }
            },
            "H3": {
              "color": "#767676"
            }
          },
          "_name": "tabs1",
          "_customHTML": "<section class=\"tabs01\" group=\"Accordion &amp; Toggles &amp; Tabs\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"11\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Main Subtitle\" name=\"showSubTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Main Title\" name=\"showmainTitle\" checked=\"\">\n        <input type=\"color\" title=\"Tabs Color\" name=\"tabsColor\" value=\"#000000\">\n        <select title=\"Tabs Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected=\"\">6</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" parallax=\"\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n\n        <div class=\"row\">\n\n\n            <div class=\"mbr-black col-md-12 col-lg-12\">\n                <div class=\"title-align align-center\">\n                    <h4 class=\"mbr-section-subtitle mbr-semibold align-center mbr-light mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .title-align\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\">My</h4>\n                </div>\n                <h1 class=\"mbr-section-title align-center mbr-bold pb-5 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showmainTitle\">AWARDS</h1>\n            </div>\n\n\n            <div class=\"col-12 tabs-col col-md-12\">\n                <ul class=\"nav nav-tabs\" role=\"tablist\">\n                    <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item first\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" href=\"#tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            2025</a></li>\n                    <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            2026</a></li>\n                    <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab3\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            2027</a></li>\n                    <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab4\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            2028</a></li>\n                    <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab5\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            2029</a></li>\n                    <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 5\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab6\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            2029</a></li>\n                </ul>\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h2 class=\"align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\">AIM\n                                    Independent Music Awards</h2>\n                                <h3 class=\"align-left pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">Best Small Label\n                                </h3>\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">Lorem ipsum dolor\n                                    sit amet, consectetur adipiscing elit. Vestibulum in fermentum tellus. Etiam turpis\n                                    metus, mattis vel ullamcorper sed, convallis eget tellus. Aliquam luctus nisl justo,\n                                    iaculis maximus tortor hendrerit eget. Quisque vehicula nisl eget tincidunt auctor.\n                                    Donec vitae justo aliquet est luctus tincidunt eget eu mi. Aenean eget diam a lectus\n                                    maximus pharetra. Praesent semper, est nec ornare luctus, risus ligula scelerisque\n                                    libero.<br><br>Praesent dignissim ex sed gravida accumsan. Quisque malesuada lorem\n                                    non urna molestie, maximus posuere nisi consectetur. Curabitur eu quam nec magna\n                                    rhoncus molestie.&nbsp;Morbi diam nibh, facilisis sed ante nec, interdum faucibus\n                                    sapien. Integer risus justo, malesuada sit amet vehicula.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h2 class=\"align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\">CMC Music\n                                    Awards</h2>\n                                <h3 class=\"align-left pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">International\n                                    Artist of the Year</h3>\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">Etiam mollis, metus\n                                    nec maximus tempus, sem metus fringilla orci, quis imperdiet velit nunc eu tortor.\n                                    Proin dictum molestie lobortis. In sit amet mauris a nisi tempus laoreet eget id\n                                    velit. Aliquam viverra auctor massa a vestibulum. Nulla eu arcu et orci facilisis\n                                    suscipit viverra at nibh. Integer iaculis semper placerat. <br><br>Fusce quis nunc\n                                    sit amet leo vestibulum posuere. Mauris sodales ex eu feugiat vehicula. Phasellus\n                                    eleifend eros nec ultricies egestas. Aenean lacinia massa purus, facilisis hendrerit\n                                    nibh porttitor vitae. Mauris fermentum nulla tellus, non eleifend nisi congue a. Sed\n                                    consequat ligula risus, ac scelerisque orci egestas a.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h2 class=\"align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\">Global\n                                    Awards</h2>\n                                <h3 class=\"align-left pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">Best Song</h3>\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">Nam a arcu urna.\n                                    Nunc sollicitudin laoreet aliquet. Vivamus mollis ex eget dictum maximus. Donec eu\n                                    lectus vitae massa fringilla vestibulum ut sed leo. Proin vitae velit orci. Nullam a\n                                    elit lacinia, fermentum elit scelerisque, dictum odio. Cras volutpat dapibus massa.\n                                    Mauris eget eros nec mauris dignissim porta. Pellentesque nec tempor tortor.\n                                    Vestibulum at elementum libero. Vivamus pellentesque at quam ut faucibus.\n                                    <br><br>Suspendisse eu urna quis nisi pretium dapibus vel sit amet elit. Nullam in\n                                    lacus risus. Donec malesuada nisl lacinia mauris posuere, eu varius nibh lacinia.\n                                    Morbi diam nibh, facilisis sed ante nec, interdum faucibus sapien. Integer risus\n                                    justo, malesuada sit amet vehicula a, feugiat vel nibh.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h2 class=\"align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\">Outstanding\n                                    Contribution to Music</h2>\n                                <h3 class=\"align-left pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">Artist Award\n                                </h3>\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">Vivamus\n                                    sollicitudin odio id augue auctor, non aliquet mi imperdiet. Etiam pretium porttitor\n                                    turpis sed blandit. Nam posuere malesuada porta. Nam sed tortor in neque finibus\n                                    consectetur. Curabitur vitae vehicula enim, sed molestie ligula. Suspendisse\n                                    potenti. Sed volutpat, ligula vitae vulputate scelerisque, sapien erat rhoncus\n                                    lorem, sit amet rhoncus neque enim vitae sem. Nullam imperdiet eleifend sodales.\n                                    <br><br>Nulla mi erat, rhoncus pretium consequat nec, cursus ac ante. Vivamus\n                                    molestie efficitur lacus. Sed dignissim, diam non tempor pulvinar, magna turpis\n                                    tincidunt ipsum, ac porta justo nibh sit amet sem. Nam a justo sit amet sapien\n                                    commodo cursus at eget velit. Donec maximus sit amet dolor vel dapibus. Donec\n                                    faucibus sodales leo vitae vestibulum. Nulla fermentum purus et lacus convallis,\n                                    eget tempor ipsum commodo.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h2 class=\"align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\">Midlands\n                                    Music Awards</h2>\n                                <h3 class=\"align-left pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">Best Music Video\n                                    of the Year</h3>\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">Donec vel nisl nec\n                                    dui consectetur blandit sit amet et eros. Nulla ultricies nisl nibh. Morbi in ligula\n                                    tortor. Maecenas interdum tincidunt libero. Ut varius lectus vitae tincidunt\n                                    maximus. Donec aliquet nulla eu odio dignissim ultricies. Etiam urna lorem, maximus\n                                    sodales eros non, fringilla fermentum metus. Maecenas cursus purus convallis dapibus\n                                    lacinia. Donec aliquet at mi id iaculis. Mauris in magna odio. <br><br>Morbi at quam\n                                    ultricies, finibus nulla sed, facilisis nisl. Aenean diam enim, mattis ac nulla\n                                    placerat, scelerisque dignissim arcu. Mauris sodales ex eu feugiat vehicula.\n                                    Phasellus eleifend eros nec ultricies egestas. Aenean lacinia massa purus, facilisis\n                                    hendrerit nibh porttitor vitae.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab6\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 5\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h2 class=\"align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\">UK Music\n                                    Video Awards</h2>\n                                <h3 class=\"align-left pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">People's Choice\n                                    Award</h3>\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">Mauris eget eros\n                                    nec mauris dignissim porta. Pellentesque nec tempor tortor. Vestibulum at elementum\n                                    libero. Vivamus pellentesque at quam ut faucibus. Suspendisse eu urna quis nisi\n                                    pretium dapibus vel sit amet elit. Nullam in lacus risus. Donec malesuada nisl\n                                    lacinia mauris posuere, eu varius nibh lacinia. Morbi diam nibh, facilisis sed ante\n                                    nec, interdum faucibus sapien. Integer risus justo, malesuada sit amet vehicula a,\n                                    feugiat vel nibh.<br><br>Sed dignissim, diam non tempor pulvinar, magna turpis\n                                    tincidunt ipsum, ac porta justo nibh sit amet sem. Nam a justo sit amet sapien\n                                    commodo cursus at eget velit. Donec maximus sit amet dolor vel dapibus. Donec\n                                    faucibus sodales leo vitae vestibulum. Nulla fermentum purus et lacus convallis,\n                                    eget tempor ipsum commodo.<br></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "rOpdt5bvhf",
          "_anchor": "tabs1-0",
          "_sourceTheme": "audiom4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background": "linear-gradient(45deg, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".wrapper": {
              "position": "relative",
              "height": "700px",
              "display": "flex"
            },
            "a": {
              "text-decoration": "underline"
            },
            ".overlay": {
              "position": "absolute",
              "width": "100%",
              "height": "100%",
              "top": "0",
              "left": "0",
              "transition": "all 0.5s",
              "background": "@overlay2",
              "opacity": "0",
              "z-index": "10"
            },
            ".content": {
              "z-index": "99",
              "position": "relative",
              "margin-bottom": "2rem",
              "margin-top": "auto",
              "max-width": "700px"
            },
            "img": {
              "width": "600px",
              "position": "absolute",
              "border-radius": "100%",
              "height": "600px",
              "object-fit": "cover"
            },
            ".img2": {
              "top": "2rem",
              "left": "0",
              "width": "500px",
              "height": "500px",
              "z-index": "3"
            },
            ".img1": {
              "top": "50%",
              "right": "50%",
              "left": "50%",
              "bottom": "50%",
              "transform": "translate(-50%, -50%)",
              "z-index": "2"
            },
            ".img3": {
              "bottom": "2rem",
              "right": "0",
              "width": "500px",
              "height": "500px",
              "z-index": "1"
            },
            "@media (max-width: 992px)": {
              ".img1, .img2, .img3": {
                "width": "400px",
                "height": "400px"
              }
            },
            "@media (max-width: 767px)": {
              ".img1, .img2, .img3": {
                "width": "200px",
                "height": "200px"
              },
              ".wrapper": {
                "height": "400px"
              },
              ".overlay": {
                "opacity": "0.5"
              }
            }
          },
          "_name": "image4",
          "_customHTML": "<section class=\"image4\" group=\"Images\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked=\"\">\n        <input type=\"color\" name=\"overlay2\" title=\"Mobile Overlay Color\" value=\"#000000\" selected=\"\">\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" parallax=\"\">\n            <input type=\"color\" title=\"Background Color\" value=\"#000000\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Gradient\" name=\"gradientBg\" condition=\"bg.type == 'color'\">\n        <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#000000\" condition=\"gradientBg &amp;&amp; bg.type == 'color'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"overlay\"></div>\n\n    <div class=\"container\">\n        <div class=\"row\">\n\n\n\n            <div class=\"col-md-12 col-lg-12 wrapper \">\n\n                <img class=\"img1\" src=\"@PROJECT_PATH@/assets/images/01.jpg\" alt=\"Mobirise\">\n                <img class=\"img2\" src=\"@PROJECT_PATH@/assets/images/03.jpg\" alt=\"Mobirise\">\n                <img class=\"img3\" src=\"@PROJECT_PATH@/assets/images/02.jpg\" alt=\"Mobirise\">\n\n                <div class=\"content\">\n                    <h2 class=\"mbr-section-title align-left mbr-bold mbr-white mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\">NEW SINGLE</h2>\n\n                    <p class=\"mbr-text align-left mbr-semibold mbr-white pb-3 mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\" mbr-theme-style=\"display-7\">Lorem ipsum dolor\n                        sit amet, consectetur adipiscing elit. In consequat, mauris ut varius feugiat, lacus ipsum\n                        sagittis ligula.&nbsp; Music is THE BEST <a href=\"#\"><b>LISTEN NOW</b></a><br></p>\n\n\n                </div>\n            </div>\n\n\n\n\n\n        </div>\n    </div>\n\n</section>",
          "_anchor": "image4-4",
          "_isUserblock": true,
          "_sourceTheme": "audiom4",
          "_cid": "rJ1PLQ7mPT",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "h3": {
              "line-height": "1",
              "letter-spacing": "-3px",
              "&:before": {
                "position": "absolute",
                "content": "''",
                "left": "50%",
                "top": "-120px",
                "bottom": "0",
                "width": "1px",
                "height": "100px",
                "background": "currentColor"
              },
              "&:after": {
                "position": "absolute",
                "content": "''",
                "left": "50%",
                "bottom": "-120px",
                "width": "1px",
                "height": "100px",
                "background": "currentColor"
              },
              "position": "relative"
            },
            ".mbr-iconfont": {
              "margin-top": "150px",
              "display": "block",
              "font-size": "3rem",
              "color": "@iconColor"
            }
          },
          "_name": "info2",
          "_customHTML": "<section class=\"info2\" group=\"Info\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"10\" max=\"15\" step=\"1\" value=\"12\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"5\" max=\"15\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Icon\" name=\"showIcon\" checked=\"\">\n\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\" selected=\"\" condition=\"showIcon\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" parallax=\"\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container align-center\">\n        <div class=\"row\">\n            <div class=\"mbr-black col-md-12 col-lg-12\">\n                <h3 class=\"mbr-section-subtitle mbr-semibold align-center mbr-light mbr-fonts-style\" mbr-theme-style=\"display-2\"><i>Music, admitted to the soul, becomes a sort of spirit</i></h3>\n                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-star mobi-mbri\" mbr-if=\"showIcon\"></span>\n\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "info2-5",
          "_isUserblock": true,
          "_sourceTheme": "audiom4",
