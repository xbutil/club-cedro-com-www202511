          "_name": "slider1",
          "_sourceTheme": "audiom4",
          "_customHTML": "<section class=\"carousel slide slider1 audiom4_slider1\" group=\"Sliders & Gallery\" plugins=\"YTPlayer,VimeoPlayer,SliderVideo,BootstrapCarouselSwipe\" data-interval=\"false\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<!-- <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked> -->\n\t\t<input type=\"hidden\" name=\"typeSlider\" value=\"headerSlider\" checked>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\" inline>\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\" inline>\n\t\t<input type=\"range\" title=\"Size\" name=\"sliderHSize\" min=\"30\" max=\"95\" step=\"1\" value=\"95\" inline>\n\t\t<input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n\t\t<hr>\n\t\t<input type=\"carousel\" title=\"Slides\" name=\"slides\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\t<div class=\"container content-slider\">\n\t\t<div class=\"content-slider-wrap\">\n\t\t\t<div mbr-carousel=\"slides\"></div>\n\t\t</div>\n\t</div>\n</section>",
