          "_name": "content6",
          "_customHTML": "<section class=\"content5\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"11\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showmainTitle\" checked>\n        <input type=\"range\" inline title=\"Items\" name=\"menuItems1\" min=\"1\" max=\"15\" step=\"1\" value=\"5\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n\n\n            <div class=\"mbr-black col-md-12 col-lg-12\">\n                <div class=\"title-align align-center\">\n                    <h2 class=\"mbr-section-subtitle mbr-semibold align-center mbr-light mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .title-align\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\">Internacionales</h2>\n                </div>\n                <h1 class=\"mbr-section-title align-center mbr-bold pb-5 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showmainTitle\">PARTIDOS</h1>\n            </div>\n\n            <div class=\"col-12 list-col col-md-12 col-lg-12 md-pb\">\n\n\n                <ul class=\"list\" mbr-list mbr-list-grow=\"menuItems1\">\n                    <li class=\"item-wrap\">\n\n                        <div class=\"date-wrap\">\n                            <h3 mbr-text class=\" mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\">20</h3>\n\n                            <h4 mbr-text class=\"mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                Noviembre<br>2025</h4>\n                        </div>\n\n                        <div class=\"location-wrap\">\n                            <h5 mbr-text class=\"mbr-bold align-left pb-1 mbr-fonts-style\" mbr-theme-style=\"display-5\">\n                                Videotron Center</h5>\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n                                <h6 mbr-text class=\"location mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".location, .icon-wrap\">Manhadtan, NY, United States</h6>\n                            </div>\n                        </div>\n\n\n\n                        <div class=\"mbr-section-btn align-right\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-layers mbr-iconfont mbr-iconfont-btn\"></span>Buy\n                                Tickets</a></div>\n                    </li>\n\n                    <li class=\"item-wrap\">\n\n                        <div class=\"date-wrap\">\n                            <h3 mbr-text class=\" mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\">06</h3>\n\n                            <h4 mbr-text class=\"mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                Diciembre<br>2025</h4>\n                        </div>\n\n                        <div class=\"location-wrap\">\n                            <h5 mbr-text class=\"mbr-bold align-left pb-1 mbr-fonts-style\" mbr-theme-style=\"display-5\">\n                                Spotify On Stage</h5>\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n                                <h6 mbr-text class=\"location mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".location, .icon-wrap\">Suncorp Stadium, Chile</h6>\n                            </div>\n                        </div>\n\n\n\n                        <div class=\"mbr-section-btn align-right\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Sold Out</a></div>\n                    </li>\n                    <li class=\"item-wrap\">\n\n                        <div class=\"date-wrap\">\n                            <h3 mbr-text class=\" mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\">15</h3>\n\n                            <h4 mbr-text class=\"mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                February<br>2026</h4>\n                        </div>\n\n                        <div class=\"location-wrap\">\n                            <h5 mbr-text class=\"mbr-bold align-left pb-1 mbr-fonts-style\" mbr-theme-style=\"display-5\">\n                                Halloween Bitchy Land</h5>\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n                                <h6 mbr-text class=\"location mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".location, .icon-wrap\">Mediolanum Forum, Italy</h6>\n                            </div>\n                        </div>\n\n\n\n                        <div class=\"mbr-section-btn align-right\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-layers mbr-iconfont mbr-iconfont-btn\"></span>Buy\n                                Tickets</a></div>\n                    </li>\n                    <li class=\"item-wrap\">\n\n                        <div class=\"date-wrap\">\n                            <h3 mbr-text class=\" mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\">28</h3>\n\n                            <h4 mbr-text class=\"mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                April<br>2026</h4>\n                        </div>\n\n                        <div class=\"location-wrap\">\n                            <h5 mbr-text class=\"mbr-bold align-left pb-1 mbr-fonts-style\" mbr-theme-style=\"display-5\">\n                                Cornelius - Singha Light</h5>\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n                                <h6 mbr-text class=\"location mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".location, .icon-wrap\">Odyssey, United Kingdom</h6>\n                            </div>\n                        </div>\n\n\n\n                        <div class=\"mbr-section-btn align-right\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Free</a></div>\n                    </li>\n                    <li class=\"item-wrap\">\n\n                        <div class=\"date-wrap\">\n                            <h3 mbr-text class=\" mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\">02</h3>\n\n                            <h4 mbr-text class=\"mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                June<br>2026</h4>\n                        </div>\n\n                        <div class=\"location-wrap\">\n                            <h5 mbr-text class=\"mbr-bold align-left pb-1 mbr-fonts-style\" mbr-theme-style=\"display-5\">\n                                Karma Kruise</h5>\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n                                <h6 mbr-text class=\"location mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".location, .icon-wrap\">AMI Stadium, New Zealand</h6>\n                            </div>\n                        </div>\n\n\n\n                        <div class=\"mbr-section-btn align-right\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-layers mbr-iconfont mbr-iconfont-btn\"></span>Buy\n                                Tickets</a></div>\n                    </li>\n                </ul>\n\n            </div>\n\n\n\n\n\n\n\n        </div>\n    </div>\n</section>",
          "_anchor": "content6-1",
          "_isUserblock": true,
          "_sourceTheme": "audiom4",
